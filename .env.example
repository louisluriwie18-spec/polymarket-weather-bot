# ───────────────────────────────────────────────────────────────
# Polymarket Weather Bot — Environment Variables Template
# Copy this file to .env and populate your actual values.
# ───────────────────────────────────────────────────────────────

# WeatherAPI.com — free tier key (https://www.weatherapi.com/)
WEATHERAPI_KEY=your_weatherapi_key_here

# Simulated starting bankroll for position sizing (pUSD).
# Set this to match your real Polymarket balance for accurate stake sizing.
DRY_RUN_STARTING_BANKROLL=20.0

# Safety flag — true for simulation/recommendation mode, false for live tracking
DRY_RUN=true
